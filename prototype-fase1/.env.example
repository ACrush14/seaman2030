# Copie este arquivo para .env e preencha sua chave.
# Alternativa: rode `ant auth login` e deixe ANTHROPIC_API_KEY vazio.
ANTHROPIC_API_KEY=

# Modelo a usar. Padrão: claude-opus-4-8 (melhor qualidade).
# Para reduzir custo durante testes longos, considere claude-sonnet-5 ou claude-haiku-4-5.
CLAUDE_MODEL=claude-opus-4-8
